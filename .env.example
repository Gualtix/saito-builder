# Local development settings. Copy to .env and fill in what you need.
# .env is never loaded automatically: export the vars, or run
#   npx tsx --env-file=.env packages/cli/src/index.ts <command>
#
# For ./deploy.sh, copy this file per site and environment instead (git-ignored):
#   environments/<site-id>/.local.env | .staging.env | .prod.env
# ./deploy.sh sets SAITO_ENV from its target, so the file's SAITO_ENV is ignored there.
#
# Staging and production do not read this file. CI takes their values from GitHub
# (.github/workflows/deploy.yml):
#   repository variables  DEPLOY_PROVIDER, CLOUDFLARE_ACCOUNT_ID, SAITO_CONTENT_SOURCE, SANITY_PROJECT_ID
#   environment secrets   CLOUDFLARE_API_TOKEN (staging and production environments);
#                         SANITY_READ_TOKEN only if the datasets are private
#   set by the workflow   SAITO_ENV (SANITY_DATASET then defaults to the environment name)
# SAITO_SITE, SAITO_ROOT and SAITO_OUT_DIR are set by the CLI; do not set them here.
# The GitHub token that lets Sanity trigger deploys is not an env var: it lives only in the
# Sanity webhook's Authorization header (sanity.io/manage → API → Webhooks).

# Target environment: development | staging | production
SAITO_ENV=development

# Content source. "local" reads sites/<id>/site.config.yaml only.
# "sanity" overlays page content managed in Sanity on top of the local config.
SAITO_CONTENT_SOURCE=local

# Sanity (only needed when SAITO_CONTENT_SOURCE=sanity, or for `saito seed`)
SANITY_PROJECT_ID=
SANITY_API_VERSION=2025-01-01
# Dataset defaults to the environment name (development|staging|production).
# Set it (e.g. to staging) when the project has no dataset with that name.
SANITY_DATASET=
# Read token is only required for private datasets / drafts preview
SANITY_READ_TOKEN=
# Editor token used only by `saito seed` (local content + images → Sanity). Keep it out of CI build jobs.
SANITY_WRITE_TOKEN=

# Optional backend API (apps/api)
API_PORT=8787
API_HOST=0.0.0.0
# Where form submissions are stored; defaults to apps/api/data
API_DATA_DIR=

# Manual deploy from your machine (./deploy.sh → scripts/deploy.sh). CI uses GitHub variables/secrets instead.
# Provider: cloudflare-pages | netlify | s3-cloudfront | none
DEPLOY_PROVIDER=none
CLOUDFLARE_ACCOUNT_ID=
# API token with Account · Cloudflare Pages · Edit
CLOUDFLARE_API_TOKEN=

# Sanity Studio (apps/studio). The Sanity CLI reads only apps/studio/.env, so put these there.
SANITY_STUDIO_PROJECT_ID=
# Datasets that exist in the project; the first one is the Studio's landing workspace.
# Baked in at build time: run `npx sanity deploy` again after changing it.
SANITY_STUDIO_DATASETS=staging,production
# `sanity deploy` publishes to https://<hostname>.sanity.studio
SANITY_STUDIO_HOSTNAME=
