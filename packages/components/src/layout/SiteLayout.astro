---
import type { ResolvedPage, ResolvedSite } from '@saito/core';
import Footer from './Footer.astro';
import Head from './Head.astro';
import Header from './Header.astro';

interface Props {
  site: ResolvedSite;
  page: ResolvedPage;
}

const { site, page } = Astro.props;
const commerce = site.integrations.commerce;
---

<!doctype html>
<html lang={site.locale} data-site={site.id} data-tenant={site.tenant}>
  <head>
    <Head site={site} page={page} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-background font-body text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 saito-btn saito-btn-primary">Skip to content</a>
    <Header site={site} currentPath={page.path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer site={site} />
    {
      commerce?.provider === 'snipcart' && (
        <div hidden id="snipcart" data-api-key={commerce.publicKey} data-currency={commerce.currency.toLowerCase()} data-config-modal-style="side" />
      )
    }
  </body>
</html>
