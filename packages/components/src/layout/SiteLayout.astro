---
import { jsonForScript, type ResolvedPage, type ResolvedSite } from '@saito/core';
import Footer from './Footer.astro';
import Head from './Head.astro';
import Header from './Header.astro';
import WhatsappCart from './WhatsappCart.astro';
import { strings } from '../strings.ts';
import type { PwaData } from '../web/pwa.ts';

interface Props {
  site: ResolvedSite;
  page: ResolvedPage;
}

const { site, page } = Astro.props;
const commerce = site.integrations.commerce;
const t = strings(site.locale);
// pwa: copy and service-worker path for web/pwa.ts, only when the site opts in with brand.pwa
const pwa = site.brand.pwa;
const pwaData: PwaData | undefined = pwa && {
  siteId: site.id,
  serviceWorker: pwa.serviceWorker,
  text: {
    pwaInstall: t.pwaInstall,
    pwaIosTitle: t.pwaIosTitle,
    pwaIosIntro: t.pwaIosIntro.replace('{name}', site.name),
    pwaIosShare: t.pwaIosShare,
    pwaIosAdd: t.pwaIosAdd,
    close: t.close,
    pwaOfflineTitle: t.pwaOfflineTitle,
    pwaOfflineBody: t.pwaOfflineBody.replace('{name}', site.name),
    pwaOfflineAuto: t.pwaOfflineAuto,
    pwaRetry: t.pwaRetry,
  },
};
---

<!doctype html>
<html
  lang={site.locale}
  data-site={site.id}
  data-tenant={site.tenant}
  data-heading-decoration={site.theme.headingDecoration === 'bar' ? 'bar' : undefined}
>
  <head>
    <Head site={site} page={page} />
    {
      /* site-chrome: scroll reveal, only when the theme asks for it */
      site.theme.motion?.reveal && (
        <script>
          import '../web/reveal.ts';
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-background font-body text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 saito-btn saito-btn-primary">{t.skipToContent}</a>
    <Header site={site} currentPath={page.path} page={page} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer site={site} />
    {
      commerce?.provider === 'snipcart' && (
        <div hidden id="snipcart" data-api-key={commerce.publicKey} data-currency={commerce.currency.toLowerCase()} data-config-modal-style="side" />
      )
    }
    {commerce?.provider === 'whatsapp' && <WhatsappCart site={site} commerce={commerce} />}
    {
      pwaData && (
        <>
          <saito-offline-notice />
          <script type="application/json" id="saito-pwa-data" is:inline set:html={jsonForScript(pwaData)} />
          <script>
            import '../web/pwa.ts';
          </script>
        </>
      )
    }
  </body>
</html>
