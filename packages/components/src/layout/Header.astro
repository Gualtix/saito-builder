---
import { safeHref, type Navigation, type ResolvedPage, type ResolvedSite } from '@saito/core';
import Button from '../ui/Button.astro';
import { icons, iconSvgAttrs, type IconName } from '../ui/icons.ts';
import { strings } from '../strings.ts';

interface Props {
  site: ResolvedSite;
  currentPath: string;
  /** site-chrome: the page being rendered, to decide whether the header can sit transparent over its hero. */
  page?: ResolvedPage;
}

const { site, currentPath, page } = Astro.props;
const { links, cta, iconLinks } = site.navigation;
const hasCart = site.integrations.commerce?.provider === 'snipcart';
const t = strings(site.locale);
const isCurrent = (href: string) => href === currentPath;

// --- site-chrome: transparent header and icon links ---
// Transparent only over a photo hero that opens the page. It renders solid ([data-solid]) and web/header.ts
// clears that while the page is at the top, so without JavaScript the header stays solid.
const first = page?.sections[0];
const transparent = site.navigation.transparent === true && first?.type === 'hero' && first.layout === 'image-background' && !!first.image;
const Bar = transparent ? 'saito-header' : 'div';
const linkClass = transparent ? 'text-sm font-medium transition hover:opacity-75' : 'text-sm font-medium text-muted transition hover:text-ink';
type IconLinkIcon = Navigation['iconLinks'][number]['icon'];
const iconFor = (icon: IconLinkIcon): IconName => (icon === 'email' ? 'mail' : icon);
const iconLabels: Record<IconLinkIcon, string> = {
  email: t.emailLink,
  x: 'X',
  facebook: 'Facebook',
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
  youtube: 'YouTube',
  github: 'GitHub',
  tiktok: 'TikTok',
};
// --- end site-chrome ---
---

<header
  class={transparent
    ? 'fixed inset-x-0 top-0 z-40 text-white transition-[background-color,box-shadow,color] duration-300 data-solid:bg-background/95 data-solid:text-ink data-solid:shadow-[0_1px_0_var(--saito-color-border)] data-solid:backdrop-blur-[8px]'
    : 'sticky top-0 z-40 border-b border-line bg-background/90 text-ink backdrop-blur'}
  data-transparent={transparent ? '' : undefined}
  data-solid={transparent ? '' : undefined}
>
  <Bar class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a href="/" class="font-heading flex items-center gap-2 text-lg font-bold">
      {
        site.brand.logo ? (
          <img src={site.brand.logo.src} alt={site.brand.logo.alt || site.name} class="h-8 w-auto" width={site.brand.logo.width} height={site.brand.logo.height} />
        ) : (
          site.brand.logoText
        )
      }
    </a>

    <nav aria-label={t.navMain} class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a href={safeHref(link.href)} class={linkClass} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      {
        hasCart && (
          <button type="button" class="snipcart-checkout text-sm font-medium">
            {t.cart} (<span class="snipcart-items-count">0</span>)
          </button>
        )
      }
      {cta && <Button link={cta} class="!px-4 !py-2 text-sm" />}{
        iconLinks.length > 0 && (
          <span class="hidden gap-2 min-[981px]:flex">
            {iconLinks.map((link) => (
              <a
                href={safeHref(link.href)}
                aria-label={iconLabels[link.icon]}
                class="grid h-11 w-11 place-items-center rounded-full border-[1.5px] border-current transition-colors hover:bg-current/10"
              >
                <svg {...iconSvgAttrs} class="h-[18px] w-[18px]" set:html={icons[iconFor(link.icon)]} />
              </a>
            ))}
          </span>
        )
      }
    </nav>

    <details class="relative md:hidden">
      <summary
        class={transparent
          ? 'cursor-pointer list-none rounded-theme border border-current px-3 py-1.5 text-sm font-medium'
          : 'cursor-pointer list-none rounded-theme border border-line px-3 py-1.5 text-sm font-medium'}
      >{t.menu}</summary>
      <nav aria-label={t.navMobile} class="absolute right-0 mt-2 flex w-56 flex-col gap-1 rounded-theme border border-line bg-background p-2 shadow-lg">
        {
          links.map((link) => (
            <a href={safeHref(link.href)} class="rounded-theme px-3 py-2 text-sm hover:bg-surface">
              {link.label}
            </a>
          ))
        }
        {
          hasCart && (
            <button type="button" class="snipcart-checkout rounded-theme px-3 py-2 text-left text-sm hover:bg-surface">
              {t.cart} (<span class="snipcart-items-count">0</span>)
            </button>
          )
        }
        {cta && <Button link={cta} class="mt-1 w-full !py-2 text-sm" />}
      </nav>
    </details>
  </Bar>{
    transparent && (
      <>
        {/* Runs while parsing, so a page opened at the top paints transparent instead of fading from solid. */}
        <script is:inline>if (scrollY <= 60) document.currentScript.parentElement.removeAttribute('data-solid');</script>
        <script>
          import '../web/header.ts';
        </script>
      </>
    )
  }
</header>
