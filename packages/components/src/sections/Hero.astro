---
import type { ResolvedSite, SectionOf } from '@saito/core';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';

interface Props {
  section: SectionOf<'hero'>;
  site: ResolvedSite;
}

const { section } = Astro.props;
const { layout, image } = section;
const isSplit = layout === 'split';
const overlay = layout === 'image-background' && image;
// site-chrome: `display` sets the heading as a fluid wordmark; it wraps (never overflows) on phones.
const display = section.headingSize === 'display';
const headingClass = display
  ? ['font-heading text-[clamp(3.2rem,12.5vw,9.5rem)] leading-none font-bold text-balance wrap-break-word', overlay && '[text-shadow:0_4px_30px_rgba(0,0,0,.45)]']
      .filter(Boolean)
      .join(' ')
  : 'font-heading text-4xl font-extrabold tracking-tight text-balance sm:text-6xl';
---

<Section section={section} width="wide" class={overlay ? 'relative overflow-hidden' : ''}>
  {
    overlay && (
      <>
        <img src={image.src} alt="" class="absolute inset-0 h-full w-full object-cover" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-scrim" />
      </>
    )
  }
  <div
    class:list={[
      'relative',
      isSplit ? 'grid items-center gap-12 lg:grid-cols-2' : display ? 'mx-auto text-center' : 'mx-auto max-w-3xl text-center',
      overlay && 'py-12 text-white',
    ]}
  >
    <div>
      {section.eyebrow && <p class="saito-eyebrow mb-4">{section.eyebrow}</p>}
      <h1 class={headingClass}>{section.heading}</h1>
      {section.subheading && <p class:list={['mt-6 text-lg sm:text-xl', overlay ? 'text-white/85' : 'saito-muted']}>{section.subheading}</p>}
      {
        (section.primaryAction || section.secondaryAction) && (
          <div class:list={['mt-10 flex flex-wrap gap-4', !isSplit && 'justify-center']}>
            {section.primaryAction && <Button link={section.primaryAction} />}
            {section.secondaryAction && <Button link={section.secondaryAction} variant="secondary" />}
          </div>
        )
      }
    </div>
    {
      isSplit && (
        <div class="aspect-[4/3] overflow-hidden rounded-image border border-line bg-surface">
          {image ? (
            <img src={image.src} alt={image.alt} width={image.width} height={image.height} class="h-full w-full object-cover" loading="eager" />
          ) : (
            <div class="h-full w-full bg-gradient-to-br from-primary/30 via-accent/20 to-transparent" aria-hidden="true" />
          )}
        </div>
      )
    }
  </div>
</Section>
