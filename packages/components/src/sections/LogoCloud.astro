---
import { safeHref, type ResolvedSite, type SectionOf } from '@saito/core';
import Section from '../ui/Section.astro';

interface Props {
  section: SectionOf<'logoCloud'>;
  site: ResolvedSite;
}

const { section } = Astro.props;
---

<Section section={section} class="!py-12">
  {section.heading && <p class="saito-muted mb-8 text-center text-sm font-semibold tracking-wider uppercase">{section.heading}</p>}
  <ul class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
    {
      section.logos.map((logo) => {
        const content = logo.src ? (
          <img src={logo.src} alt={logo.name} class="h-8 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0" loading="lazy" />
        ) : (
          <span class="font-heading text-xl font-bold opacity-60">{logo.name}</span>
        );
        return <li>{logo.href ? <a href={safeHref(logo.href)} rel="noopener noreferrer">{content}</a> : content}</li>;
      })
    }
  </ul>
</Section>
