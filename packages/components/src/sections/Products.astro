---
import { formatPrice, safeHref, type ResolvedSite, type SectionOf } from '@saito/core';
import AddToCart from '../ui/AddToCart.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  section: SectionOf<'products'>;
  site: ResolvedSite;
  pageUrl: string;
}

const { section, site, pageUrl } = Astro.props;
// Snipcart works purely client-side. Headless Shopify / Commerce Layer link out to each product's checkout URL.
const useCart = site.integrations.commerce?.provider === 'snipcart';
const absolute = (src: string) => (src.startsWith('/') ? `${site.url}${src}` : src);
---

<Section section={section} width="wide">
  <SectionHeader heading={section.heading} intro={section.intro} />
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      section.items.map((item) => (
        <li class="saito-card flex flex-col !p-0 overflow-hidden">
          {item.image && <img src={item.image.src} alt={item.image.alt || item.name} class="aspect-square w-full object-cover" loading="lazy" />}
          <div class="flex flex-1 flex-col p-6">
            <h3 class="font-heading text-lg font-semibold">{item.name}</h3>
            {item.description && <p class="mt-2 flex-1 text-sm text-muted">{item.description}</p>}
            <div class="mt-4 flex items-center justify-between gap-4">
              <span class="text-lg font-bold">{formatPrice(item.price, section.currency, site.locale)}</span>
              {useCart ? (
                <AddToCart
                  id={item.id}
                  name={item.name}
                  price={item.price}
                  url={pageUrl}
                  description={item.description}
                  image={item.image ? absolute(item.image.src) : undefined}
                />
              ) : (
                item.url && (
                  <a href={safeHref(item.url)} class="saito-btn saito-btn-primary !px-4 !py-1.5 text-sm" rel="noopener noreferrer">
                    Buy
                  </a>
                )
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>
