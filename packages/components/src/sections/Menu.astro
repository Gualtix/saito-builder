---
import { formatPrice, type ResolvedSite, type SectionOf } from '@saito/core';
import AddToCart from '../ui/AddToCart.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { strings } from '../strings.ts';

interface Props {
  section: SectionOf<'menu'>;
  site: ResolvedSite;
  pageUrl: string;
}

const { section, site, pageUrl } = Astro.props;
const provider = site.integrations.commerce?.provider;
const canOrder = provider === 'snipcart' || provider === 'whatsapp';
// whatsapp: buttons open <saito-product-dialog> (web/whatsapp-cart.ts); the catalogue JSON comes from SiteLayout.
const whatsapp = provider === 'whatsapp';
const showNotice = whatsapp && section.categories.some((c) => c.items.some((i) => i.orderable && i.id));
const t = strings(site.locale);
const cards = section.layout === 'cards';
const price = (amount: number) => formatPrice(amount, section.currency, site.locale);
---

<Section section={section} width={cards ? 'default' : 'narrow'}>
  <SectionHeader heading={section.heading} intro={section.intro} />
  {
    showNotice && (
      <p class="saito-order-notice">
        <svg class="mt-px size-5 flex-none text-wa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z" />
          <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-2-2l.8-1-1-2z" />
        </svg>
        <span><strong>{t.noticeTitle}</strong> {t.noticeBody}</span>
      </p>
    )
  }
  {
    cards ? (
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-5 max-[560px]:grid-cols-1 max-[560px]:gap-3">
        {section.categories.map((category) =>
          category.items.map((item) => (
            <li>
              <article class:list={['flex h-full flex-col overflow-hidden rounded-card border-[1.5px] border-line bg-background text-ink', item.image && 'max-[560px]:grid max-[560px]:grid-cols-[104px_1fr]']}>
                {item.image && (
                  <img
                    class="block aspect-[4/3] h-auto w-full object-cover max-[560px]:aspect-auto max-[560px]:h-full"
                    src={item.image.src}
                    alt={item.image.alt}
                    loading="lazy"
                    width={item.image.width ?? 400}
                    height={item.image.height ?? 300}
                  />
                )}
                <div class="flex min-w-0 flex-1 flex-col gap-1 px-4 pt-3.5 pb-4 max-[560px]:p-3">
                  <span class="text-[.72rem] font-semibold tracking-[.08em] text-muted uppercase">{category.name}</span>
                  <h3 class="text-[1.05rem] leading-[1.3] font-bold">
                    {item.name}
                    {item.tags.map((tag) => (
                      <span class="ml-2 rounded-full border border-line px-2 py-0.5 align-middle text-xs font-normal uppercase">{tag}</span>
                    ))}
                  </h3>
                  {item.description && <p class="text-[.9rem] leading-[1.45] text-muted max-[560px]:line-clamp-2">{item.description}</p>}
                  <div class="mt-auto flex items-center justify-between gap-2 pt-2.5">
                    <span class="text-[1.05rem] font-bold whitespace-nowrap">{price(item.price)}</span>
                    {canOrder && item.orderable && item.id && (whatsapp ? (
                      <button type="button" class="saito-btn saito-btn-primary !px-4 !py-2 text-sm" data-saito-add={item.id} aria-label={`${t.orderNow}: ${item.name}`}>{t.orderNow}</button>
                    ) : (
                      <AddToCart id={item.id} name={item.name} price={item.price} url={pageUrl} description={item.description} label={t.addToOrder} />
                    ))}
                  </div>
                </div>
              </article>
            </li>
          )),
        )}
      </ul>
    ) : (
      <div class="space-y-12">
        {section.categories.map((category) => (
          <div>
            <h3 class="font-heading mb-4 border-b border-line pb-2 text-2xl font-semibold">{category.name}</h3>
            <ul class="space-y-6">
              {category.items.map((item) => (
                <li class="flex items-start justify-between gap-6">
                  <div>
                    <p class="font-semibold">
                      {item.name}
                      {item.tags.map((tag) => (
                        <span class="ml-2 rounded-full border border-line px-2 py-0.5 align-middle text-xs font-normal uppercase">{tag}</span>
                      ))}
                    </p>
                    {item.description && <p class="saito-muted mt-1 text-sm">{item.description}</p>}
                  </div>
                  <div class="flex shrink-0 flex-col items-end gap-2">
                    <span class="font-semibold">{price(item.price)}</span>
                    {canOrder && item.orderable && item.id && (whatsapp ? (
                      <button type="button" class="saito-btn saito-btn-primary !px-4 !py-1.5 text-sm" data-saito-add={item.id} aria-label={`${t.orderNow}: ${item.name}`}>{t.orderNow}</button>
                    ) : (
                      <AddToCart id={item.id} name={item.name} price={item.price} url={pageUrl} description={item.description} label={t.addToOrder} />
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }
</Section>
