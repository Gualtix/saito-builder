---
import { renderRichText, type ResolvedSite, type SectionOf } from '@saito/core';
import Section from '../ui/Section.astro';

interface Props {
  section: SectionOf<'richText'>;
  site: ResolvedSite;
}

const { section } = Astro.props;
// renderRichText escapes its input before applying the small markup subset.
const html = renderRichText(section.body);
---

<Section section={section} width={section.width === 'wide' ? 'default' : 'narrow'}>
  {section.heading && <h2 class="font-heading mb-6 text-3xl font-bold tracking-tight">{section.heading}</h2>}
  <div class="saito-prose" set:html={html} />
</Section>
