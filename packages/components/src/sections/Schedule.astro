---
import type { ResolvedSite, SectionOf } from '@saito/core';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  section: SectionOf<'schedule'>;
  site: ResolvedSite;
}

const { section } = Astro.props;
---

<Section section={section} width="narrow">
  <SectionHeader heading={section.heading} intro={section.intro} />
  <div class="space-y-10">
    {
      section.days.map((day) => (
        <div>
          {section.days.length > 1 && <h3 class="font-heading mb-4 text-xl font-semibold">{day.label}</h3>}
          <ol class="divide-y divide-line rounded-theme border border-line bg-background text-ink">
            {day.items.map((item) => (
              <li class="grid grid-cols-[5rem_1fr] gap-4 p-4">
                <time class="font-mono font-semibold text-primary">{item.time}</time>
                <div>
                  <p class="font-semibold">{item.title}</p>
                  {item.speaker && <p class="text-sm text-muted">{item.speaker}</p>}
                  {item.description && <p class="mt-1 text-sm text-muted">{item.description}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</Section>
